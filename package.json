{
  "name": "chrome-my-prs",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test",
    "lint": "oxlint --deny-warnings",
    "lint:firefox": "wxt build -b firefox && web-ext lint -s .output/firefox-mv3",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "e2e": "wxt build && wxt zip -b firefox && playwright test",
    "store:images": "bun store/shoot.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/selenium-webdriver": "^4.35.7",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "selenium-webdriver": "^4.51.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
